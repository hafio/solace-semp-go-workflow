# Build output
dist/
build/

# Local broker connection for the `integration` dev task -- never commit (holds
# the SEMP password). The tracked template is scripts/local.env.example.
scripts/local.env
.env

# Test and coverage artifacts
coverage.out
coverage.html
scripts/logs/

# Editor and OS noise
nppBackup
*.bak
*.log
.claude

# Customer-named sample configs (real site/topic taxonomy) -- kept local, not a
# code dependency. The sanitized, committable samples live in examples/.
other-examples/

# NOTE: specs/ is deliberately NOT ignored. The committed SEMP schemas are the
# generator's only input and must be present in a fresh clone.

m4-run
cutover*
test.sh