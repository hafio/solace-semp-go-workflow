# scripts/local.env.example -- template for the gitignored scripts/local.env.
#
# The `integration` dev task reads the live-broker connection ONLY from
# scripts/local.env (there is no environment fallback). Copy this file, fill in
# real values, and keep the copy out of git:
#
#   cp scripts/local.env.example scripts/local.env            # bash
#   Copy-Item scripts\local.env.example scripts\local.env     # PowerShell
#
# Then run the integration suite against the broker:
#
#   ./scripts/dev.sh integration          # bash
#   .\scripts\dev.ps1 integration         # PowerShell
#
# scripts/local.env is gitignored -- NEVER commit real credentials; only this
# .example template is tracked. Both loaders skip blank lines and lines starting
# with '#', split each remaining line on the first '=', and strip surrounding
# single or double quotes. Quote any value containing spaces or shell
# metacharacters (prefer single quotes) so bash's `source` of the file is safe.

# Required -- SEMP v2 management connection.
# SEMP_HOST is the full base URL (scheme + host + port), no trailing path.
SEMP_HOST='https://broker.example.com:943'
SEMP_USERNAME='admin'
SEMP_PASSWORD='CHANGE-ME'
SEMP_MSG_VPN='default'

# Optional -- verify the broker's TLS certificate (default: false).
SEMP_VERIFY_SSL='false'
